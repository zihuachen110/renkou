---
import {
  getLocaleFromUrl,
  localePath,
  switchLocalePath,
  type Locale,
} from "../i18n";
import { getMessages } from "../i18n/messages";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const m = getMessages(locale);
const home = localePath(locale, "/");
const links = [
  { href: `${localePath(locale, "/")}#explore`, label: m.nav.explore },
  { href: localePath(locale, "/sources"), label: m.nav.sources },
  { href: localePath(locale, "/about"), label: m.nav.about },
  {
    href: `${localePath(locale, "/about")}#disclaimer`,
    label: m.nav.disclaimer,
  },
];
const zhHref = switchLocalePath(Astro.url, "zh-CN");
const enHref = switchLocalePath(Astro.url, "en");
---

<header
  class="mx-auto flex max-w-content items-baseline justify-between gap-6 px-6 pt-5"
>
  <a href={home} class="no-underline">
    <p class="m-0 text-lg font-bold tracking-tight text-ink">
      {m.brand}<span class="ml-2 text-sm font-normal text-muted"
        >{m.brandEn}</span
      >
    </p>
  </a>
  <div class="flex items-center gap-5">
    <nav class="hidden gap-5 text-[13px] font-medium sm:flex">
      {
        links.map((l) => (
          <a href={l.href} class="text-muted no-underline hover:text-ink">
            {l.label}
          </a>
        ))
      }
    </nav>
    <div
      class="flex items-center gap-1 text-[12px] font-semibold"
      role="group"
      aria-label={m.lang.switchTo}
    >
      <a
        href={zhHref}
        hreflang="zh-CN"
        lang="zh-CN"
        class:list={[
          "no-underline px-1.5 py-0.5",
          locale === "zh-CN"
            ? "text-accent"
            : "text-muted hover:text-ink",
        ]}
        aria-current={locale === "zh-CN" ? "true" : undefined}
      >
        {m.lang.zh}
      </a>
      <span class="text-line" aria-hidden="true">/</span>
      <a
        href={enHref}
        hreflang="en"
        lang="en"
        class:list={[
          "no-underline px-1.5 py-0.5",
          locale === "en" ? "text-accent" : "text-muted hover:text-ink",
        ]}
        aria-current={locale === "en" ? "true" : undefined}
      >
        {m.lang.en}
      </a>
    </div>
  </div>
</header>
